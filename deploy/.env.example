# Copy to /etc/poj/backend.env (chmod 600); never commit real secrets.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://127.0.0.1:3306/my_db?useSSL=true&serverTimezone=UTC
DB_USERNAME=poj
DB_PASSWORD=replace-with-a-unique-random-secret
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=replace-with-another-random-secret
CORS_ALLOWED_ORIGINS=https://oj.example.com
CODE_SANDBOX_BASE_URL=http://127.0.0.1:8090
CODE_SANDBOX_TOKEN=replace-with-at-least-32-random-bytes
SERVER_PORT=8121
MANAGEMENT_PORT=9121
LOG_PATH=/var/log/poj
EMAIL_ENABLED=true
EMAIL_CODE_REDIS=true
EMAIL_CODE_SECRET=replace-with-at-least-32-random-bytes
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=replace-with-smtp-app-password
MAIL_FROM=no-reply@example.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_SSL_ENABLE=false
